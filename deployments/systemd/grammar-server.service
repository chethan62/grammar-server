[Unit]
Description=grammar-server (LanguageTool-compatible, rule-based)
After=network.target

[Service]
Type=simple
ExecStart="%h/Documents/Default Project/grammar-server/bin/grammar-server" --port 8875 --dialect American
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target