[Unit]
Description=grammar-server (LanguageTool-compatible, rule-based)
After=network.target

[Service]
Type=simple
# Binary installed by `make install` (no sudo, no hardcoded source tree). harper-ls
# is found on PATH or beside the binary.
ExecStart=%h/.local/bin/grammar-server --port 8875 --dialect American
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target