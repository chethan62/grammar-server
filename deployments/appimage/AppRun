#!/bin/sh
# AppRun — the checker as one file.
#
# It is a launcher first: when a grammar-server and a UI already answer (the installed
# user units do, on 8875 and 8899), it points the browser at them and exits without
# starting anything — nothing to orphan, and every client on the machine shares one
# engine and one UI. Only what is missing is started from inside the bundle, and then
# this stays in the foreground supervising until quit or Ctrl+C.
#
# Everything but python3 comes from the bundle: grammar-server and the harper pair sit
# in the same directory (resolveHarper prefers its own directory). Nothing is written
# into the mount — it is read-only by design.
#
# Environment: GRAMMAR_PORT (8875), GRAMMAR_UI_PORT (8899), GRAMMAR_NO_OPEN=1 to skip
# opening a browser (used by the packaging tests).
set -eu

APPDIR=${APPDIR:-$(dirname "$(readlink -f "$0")")}
PORT=${GRAMMAR_PORT:-8875}
UI_PORT=${GRAMMAR_UI_PORT:-8899}
server_pid=""; ui_pid=""

log() { printf 'grammar-checker: %s\n' "$*"; }
alive() { curl -fsS --max-time 2 "$1" >/dev/null 2>&1; }
cleanup() {
	[ -n "$ui_pid" ] && kill "$ui_pid" 2>/dev/null || true
	[ -n "$server_pid" ] && kill "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# --- engine -----------------------------------------------------------------
if alive "http://127.0.0.1:$PORT/status"; then
	log "engine already on http://127.0.0.1:$PORT"
else
	"$APPDIR/grammar-server" --port "$PORT" --host 127.0.0.1 &
	server_pid=$!
	i=0
	while [ $i -lt 40 ]; do
		alive "http://127.0.0.1:$PORT/status" && break
		kill -0 "$server_pid" 2>/dev/null || { log "the engine exited — see its messages above"; exit 1; }
		i=$((i + 1)); sleep 0.25
	done
	log "engine on http://127.0.0.1:$PORT (bundled harper-ls: $APPDIR/harper-ls)"
fi

# --- UI ---------------------------------------------------------------------
# A second server on a taken port fails silently and would leave no UI at all, so an
# existing one is reused; otherwise the first free port from UI_PORT is taken.
if alive "http://127.0.0.1:$UI_PORT/"; then
	log "UI already on http://localhost:$UI_PORT/"
elif command -v python3 >/dev/null 2>&1; then
	while alive "http://127.0.0.1:$UI_PORT/"; do UI_PORT=$((UI_PORT + 1)); done
	python3 -m http.server "$UI_PORT" --bind 127.0.0.1 --directory "$APPDIR/ui" >/dev/null 2>&1 &
	ui_pid=$!
	sleep 1
	log "UI on http://localhost:$UI_PORT/"
else
	log "python3 not found — open $APPDIR/ui/index.html yourself, API field http://localhost:$PORT"
fi

URL="http://localhost:$UI_PORT/"
if [ "${GRAMMAR_NO_OPEN:-0}" != "1" ]; then
	xdg-open "$URL" >/dev/null 2>&1 || log "no browser opened; open $URL yourself"
fi

# Nothing of ours is running: the launcher's work is done. Exit instead of holding a
# mount open for a browser tab that talks to services this bundle did not start.
if [ -z "$server_pid" ] && [ -z "$ui_pid" ]; then
	log "done — the browser points at the shared services"
	exit 0
fi

log "quit this window (or Ctrl+C) to stop what this bundle started"
wait
