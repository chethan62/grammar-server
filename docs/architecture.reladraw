// grammar-server — the architecture, 2026-09-29.
// This file is the source; the picture is rendered from it, so they cannot drift apart:
//   npx reladraw docs/architecture.reladraw -o docs/architecture.svg
// Add --theme dark for a dark page. Every number is a measurement from this box (CPU-only,
// 85-95C package temp, so up to ~2x pessimistic).
//
// Design: light page; one accent, on the thing that is genuinely load-bearing (the single
// harper process behind one mutex); names in normal weight with small grey technical sublabels;
// quiet edge labels; no free-floating remarks, because a remark with no box is a remark whose
// subject the reader has to guess. Dependency direction: engine <- api <- clients; the HTTP API
// is the only door between them.

diagram  theme: light

style focal    fill: theme-primary-subtle  border: theme-primary  line: theme-primary
style sublabel fill: none  border: none  text: (size: small, color: theme-muted)
style caption  fill: none  border: none  text: (size: small, color: theme-muted)

node title "grammar-server" (size: large)  shape: none
node subtitle "What is running, and what each part costs" (size: small, color: theme-muted)  below title  gap: tight  style: caption

node apps "Any app you type in"  below subtitle  gap: normal
node apps.sub "LibreOffice · Firefox · Qt"  below apps text  style: sublabel
node watch "grammar-watch"  below apps  gap: wide
node watch.sub "systemd user unit, reads the caret over AT-SPI"  below watch text  style: sublabel
node card "Suggestion card"  right of watch  gap: wide
node card.sub "GTK3, placed at the caret"  below card text  style: sublabel
node engine "grammar-server"  below watch  gap: wide
node engine.sub "Go :8875 · LanguageTool-compatible"  below engine text  style: sublabel
node clients "Clients over the same API"  right of engine  gap: wide
node clients.sub "static UI :8899 · lookup Ctrl+Alt+C"  below clients text  style: sublabel
node ollama "ollama"  left of engine  gap: wide
node ollama.sub "/v2/rewrite only, never the check path"  below ollama text  style: sublabel
node harper "harper-ls"  below engine  gap: wide  style: focal
node harper.sub "ONE process behind ONE mutex"  below harper text  style: sublabel
node costs "200 chars 16 ms · 10 KB 1.8 s · 200 KB 36 s" (wrap: 64)  below harper  gap: tight  style: caption

edge apps -> watch   "text + caret" (size: small, color: theme-muted)
edge watch -> card    "Accept" (size: small, color: theme-muted)
edge watch -> engine  "POST /v2/check" (size: small, color: theme-muted)
edge engine -> harper "chunked at 1.5 KB per call" (size: small, color: theme-muted)
edge clients -> engine "the same API" (size: small, color: theme-muted)
edge engine -> ollama  "on demand" (size: small, color: theme-muted)
edge harper -> costs   "measured here" (size: small, color: theme-muted)
