// grammar-server — the architecture, 2026-09-29.
// Colors and this file are generated: python3 docs/palette.py writes it, and the picture
// is rendered from it, so source and picture cannot drift:
//   python3 docs/palette.py && npx reladraw docs/architecture.reladraw -o docs/architecture.svg
//
// Colour is the layer key: every box carries its own hue and every arrow leaves in the hue
// of the layer it comes from, so a line can be traced without reading its label. Mode is
// 'dark'; palette.py owns all seven hues and refuses any whose ink drops under 4.5:1 or whose outline drops under 3:1. The amber box is the one that is load-bearing: ONE
// harper process behind ONE mutex.
//
// Every number is a measurement from this box (CPU-only, 85-95C package temp, so up to ~2x
// pessimistic). Dependency direction: engine <- api <- clients; the HTTP API is the only
// door between them.

diagram  theme: dark

style apps     fill: #1d2740  border: #6f9bff  line: #6f9bff  text: (color: #e8e9ee)
style watch    fill: #251f3d  border: #a98cff  line: #a98cff  text: (color: #e8e9ee)
style card     fill: #331d2a  border: #ff85b3  line: #ff85b3  text: (color: #e8e9ee)
style engine   fill: #16302e  border: #4fd8c4  line: #4fd8c4  text: (color: #e8e9ee)
style clients  fill: #16303f  border: #5fb8e8  line: #5fb8e8  text: (color: #e8e9ee)
style ollama   fill: #1c3020  border: #7fce74  line: #7fce74  text: (color: #e8e9ee)
style harper   fill: #362708  border: #ffc04d  line: #ffc04d  text: (color: #e8e9ee)
style sublabel fill: none  border: none  text: (size: small, color: #9aa3b2)
style caption  fill: none  border: none  text: (size: small, color: #9aa3b2)

node title "grammar-server" (size: large)  shape: none
node subtitle "What is running, and what each part costs" (size: small, color: #9aa3b2)  below title  gap: tight  style: caption

node apps "Any app you type in"  below subtitle  gap: normal  style: apps
node apps.sub "LibreOffice · Firefox · Qt" (size: small, color: #a9c3ff)  below apps text  style: sublabel
node watch "grammar-watch"  below apps  gap: normal  style: watch
node watch.sub "systemd user unit, reads the caret over AT-SPI" (size: small, color: #c9b6ff)  below watch text  style: sublabel
node card "Suggestion card"  right of watch  gap: normal  style: card
node card.sub "GTK3, placed at the caret" (size: small, color: #ffb0cd)  below card text  style: sublabel
node engine "grammar-server"  below watch  gap: normal  style: engine
node engine.sub "Go :8875 · LanguageTool-compatible" (size: small, color: #9ce8dd)  below engine text  style: sublabel
node clients "Clients over the same API"  right of engine  gap: normal  style: clients
node clients.sub "static UI :8899 · lookup Ctrl+Alt+C" (size: small, color: #a5d8f5)  below clients text  style: sublabel
node ollama "ollama"  left of engine  gap: normal  style: ollama
node ollama.sub "/v2/rewrite only, never the check path" (size: small, color: #b2e5a9)  below ollama text  style: sublabel
node harper "harper-ls"  below engine  gap: normal  style: harper
node harper.sub "ONE process behind ONE mutex" (size: small, color: #ffd894)  below harper text  style: sublabel
node costs "200 chars 16 ms · 10 KB 1.8 s · 200 KB 36 s" (wrap: 64)  below harper  gap: tight  style: caption

edge apps -> watch    "text + caret" (size: small, color: #a9c3ff)  style: apps
edge watch -> card     "Accept" (size: small, color: #c9b6ff)  style: watch
edge watch -> engine   "POST /v2/check" (size: small, color: #c9b6ff)  style: watch
edge engine -> harper  "chunked at 1.5 KB per call" (size: small, color: #9ce8dd)  style: engine
edge clients -> engine "the same API" (size: small, color: #a5d8f5)  style: clients
edge engine -> ollama  "on demand" (size: small, color: #b2e5a9)  style: ollama
edge harper -> costs   "measured here" (size: small, color: #ffd894)  style: harper
